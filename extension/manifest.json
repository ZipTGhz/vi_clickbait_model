{
  "manifest_version": 3,
  "name": "ViClickbait Detector",
  "version": "1.0",
  "description": "Nhận diện tiêu đề giật tít trên báo tiếng Việt",
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.vnexpress.net/*",
        "*://*.kenh14.vn/*",
        "*://*.24h.com.vn/*",
        "*://*.tuoitre.vn/*",
        "*://*.thanhnien.vn/*"
      ],
      "js": ["utils/api_client.js", "content.js"]
    }
  ]
}
